NEXT_PUBLIC_API_BASE_URL=http://localhost:3000/
NEXT_PUBLIC_ENABLE_MSW=false

# Only needed if lib/geo/index.ts is switched to GooglePlacesProvider (not
# the active provider today — see lib/geo/georef-provider.ts). Requires a
# Google Maps JavaScript API key with "Places API (New)" and "Maps
# JavaScript API" enabled, restricted by HTTP referrer.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# Base map of the establishments map: "ignColor" (default, IGN's coloured map),
# "ign" (IGN's grey map, uncached) or "osm" (OpenStreetMap, the fastest).
# See constants/map.ts and docs/adr/0003-establishments-map-libraries.md.
NEXT_PUBLIC_MAP_TILES=

# Used by docker-compose.yml (build arg + container port mapping)
PORT=3000
